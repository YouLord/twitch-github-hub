# ─────────────────────────────────────────────────────────────
#  Скопируй в .env и заполни:  cp .env.example .env
#  Пустые поля = демо-режим (мок-данные, всё работает без токенов)
# ─────────────────────────────────────────────────────────────

# ── Twitch: https://dev.twitch.tv/console/apps (New Application) ──
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# логин канала, без @ и без ссылки (например: shroud)
TWITCH_CHANNEL=

# ── Twitch-бот (идея C): отдельный аккаунт бота ──
# OAuth-токен чата: https://twitchtokengenerator.com (Custom Scope → chat:read chat:edit)
TWITCH_BOT_USERNAME=
TWITCH_BOT_OAUTH=
# Необязательно: user-token самого стримера (broadcaster) для создания клипов командой !clip
# нужен scope: clips:edit + channel:read:stream_key нет, достаточно clips:edit
TWITCH_USER_TOKEN=

# ── GitHub ──
# владелец/репозиторий, статистику которого показываем
GITHUB_REPO=octocat/Hello-World
# токен: classic PAT со scope public_repo (или fine-grained: Contents=Read, Pull requests=Read)
GITHUB_TOKEN=
# секрет вебхука (придумай длинную строку, тот же вставь в настройках вебхука на GitHub)
GITHUB_WEBHOOK_SECRET=
# окно статистики в часах (коммиты за последние N часов)
STATS_WINDOW_HOURS=24

# ── Сервер ──
PORT=8787

# Принудительно демо-режим, даже если токены есть: DEMO=1
DEMO=

# ── Галерея клипов ──
# домены-родители для Twitch-плеера: your-username.github.io,localhost
GALLERY_PARENTS=localhost
GALLERY_MAX_CLIPS=60

# пауза между сообщениями бота в чат (анти-спам), сек
BOT_COOLDOWN_SEC=10
